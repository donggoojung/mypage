# --- Database ---
# docker-compose.yml에서 postgres 컨테이너를 5433 포트로 노출한다 (Windows가 5432를
# 막아두는 경우가 있어서). 혹시 본인 환경에서 5432가 정상이면 그 값으로 바꿔써도 된다.
DATABASE_URL=postgresql+asyncpg://fulfillment:fulfillment@localhost:5433/fulfillment
# Alembic(동기 드라이버) 전용
DATABASE_URL_SYNC=postgresql+psycopg2://fulfillment:fulfillment@localhost:5433/fulfillment

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- 외부 연동 모드 (true면 Mock 클라이언트 사용, false면 실제 API 호출) ---
USE_MOCK_SCRAPERS=true
USE_MOCK_MARKETS=true
USE_MOCK_AI_VISION=true
USE_MOCK_MESSAGING=true
USE_MOCK_RPA=true
USE_MOCK_STORAGE=true
# 경쟁가 조회는 플랫폼별로 따로 켤 수 있다 (네이버=공식 API라 안전, 쿠팡=미검증 스크래핑이라 주의)
USE_MOCK_NAVER_PRICE_CHECKER=true
USE_MOCK_COUPANG_PRICE_CHECKER=true

# --- 오픈마켓 API 키 ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 네이버 쇼핑검색 오픈API 전용 키 (https://developers.naver.com/apps 에서 "검색" API로 발급 — Commerce API 키와 다름)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_VENDOR_ID=
# WING 로그인 아이디(이메일 또는 로그인ID) — 상품 등록 API 필수 필드(vendorUserId).
# 2026-09-21 실API 검증됨: 이 값이 없으면 등록이 거부된다.
COUPANG_VENDOR_USER_ID=
# 출고지/반품지 코드는 원래 수동 입력하지 않는다 — 상품 등록 시
# app.integrations.markets.coupang.resolve_seller_info()가 쿠팡 API로 자동 조회한다.
# 다만 반품지 조회 API(returnShippingCenters)가 WING 화면엔 있는 반품지를 빈 배열로
# 돌려주는 문제(캐시 지연으로 추정)가 있을 때만, 아래를 채우면 API 조회를 건너뛰고
# 이 값을 바로 쓴다 — WING > 판매자정보 > 주소록/배송정보관리에서 반품지 "수정" 눌러 확인.
COUPANG_RETURN_CENTER_CODE=
COUPANG_RETURN_CHARGE_NAME=
COUPANG_RETURN_ZIP_CODE=
COUPANG_RETURN_ADDRESS=
COUPANG_RETURN_ADDRESS_DETAIL=
COUPANG_RETURN_CONTACT_NUMBER=
ESM_MASTER_ID=
ESM_API_KEY=

# --- RPA(무인발주) 관련 ---
# scripts/save_abc_mart_session.py로 저장한 ABC마트 로그인 쿠키 파일 경로 (보통 안 바꿔도 됨).
ABC_MART_SESSION_FILE=scripts/output/abc_mart_session.json
# 무신사 로그인 쿠키 파일 경로 — 무신사 RPA는 아직 실사이트 미검증 스켈레톤 단계라
# 저장 스크립트가 없음(나중에 실사이트 검증할 때 작성 예정). 보통 안 바꿔도 됨.
MUSINSA_SESSION_FILE=scripts/output/musinsa_session.json
# false(기본값, 안전) = RPA가 최종 결제 직전 단계까지만 진행하고 실제 결제 버튼은 누르지 않는다.
# scripts/test_rpa_checkout.py로 화면 흐름을 여러 번 눈으로 확인하기 전에는 절대 true로 바꾸지 말 것.
RPA_CONFIRM_FINAL_PAYMENT=false

# --- AI 이미지 저장소: AWS S3 또는 Cloudflare R2 (둘 다 AWS_* 키로 설정) ---
# 비워두면(기본값) USE_MOCK_STORAGE=true와 함께 로컬에만 저장되는 Mock으로 동작한다 —
# 이 경우 쿠팡 등록 시 이미지를 진짜로 다운로드하지 못해 승인반려된다. 실제 등록하려면
# 아래 중 하나를 선택해 채우고 USE_MOCK_STORAGE=false로 바꿔야 한다.
#
# [추천] Cloudflare R2 — 무료 10GB, 다운로드(egress) 비용 없음(구독료 걱정 없음):
#   1) https://dash.cloudflare.com → R2 → 버킷 생성 → "공개 액세스" 켜기(퍼블릭 도메인 발급)
#   2) R2 → "API 토큰 관리"에서 S3 호환 API 토큰 발급(계정ID/액세스키/시크릿키 확인)
#   AWS_S3_ENDPOINT_URL=https://<계정ID>.r2.cloudflarestorage.com
#   AWS_CLOUDFRONT_DOMAIN=<발급받은 pub-xxxxx.r2.dev 퍼블릭 도메인, https:// 없이>
#
# AWS S3 — 무료 한도가 가입 후 12개월뿐이고 그 이후/한도초과 시 비용 발생:
#   AWS_S3_ENDPOINT_URL은 비워둔다(AWS 기본 엔드포인트 자동 사용)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=
AWS_S3_ENDPOINT_URL=

# --- 솔라피(Solapi) ---
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_KAKAO_PFID=
# 솔라피에 사전 등록해둔 발신번호 (문자 대체발송용) — 등록 안 하면 발신 자체가 거부된다.
SOLAPI_SENDER_PHONE=
# 배송출고 안내 알림톡 템플릿 ID (카카오 채널/템플릿 심사 승인 후 발급) — 비워두면 문자로만 발송.
SOLAPI_SHIPPING_TEMPLATE_ID=

# --- 텔레그램 관리자 긴급 알림 (재고 품절/발주 실패 등 확인이 필요한 상황 전용) ---
# 1) 텔레그램 앱에서 "BotFather" 검색 → 대화 시작 → /newbot → 안내에 따라 봇 이름 정하기
#    → 마지막에 나오는 토큰(숫자:영문조합, 예: 123456789:ABC-...)을 아래에 붙여넣기
# 2) 만든 내 봇을 텔레그램에서 검색해서 대화 시작 → 아무 메시지나 1번 보내기(예: "안녕")
# 3) 브라우저에서 https://api.telegram.org/bot<위에서받은토큰>/getUpdates 접속
#    → 응답 JSON 안의 "chat":{"id": 숫자} 값을 아래 TELEGRAM_ADMIN_CHAT_ID에 붙여넣기
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --- AI 연산 API (자체 GPU 미운영 시) ---
REPLICATE_API_TOKEN=
FAL_API_KEY=

# --- 구글 AI 스튜디오(Gemini) — 상품명 SEO 정제 / 상품정보고시 스펙 요약 ---
# https://aistudio.google.com/apikey 에서 발급. 비워두면(기본값) 규칙 기반 Mock으로 동작한다.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
