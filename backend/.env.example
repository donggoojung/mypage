# --- Database ---
DATABASE_URL=postgresql+asyncpg://fulfillment:fulfillment@localhost:5432/fulfillment
# Alembic(동기 드라이버) 전용
DATABASE_URL_SYNC=postgresql+psycopg2://fulfillment:fulfillment@localhost:5432/fulfillment

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- 외부 연동 모드 (true면 Mock 클라이언트 사용, false면 실제 API 호출) ---
USE_MOCK_SCRAPERS=true
USE_MOCK_MARKETS=true
USE_MOCK_AI_VISION=true
USE_MOCK_MESSAGING=true
USE_MOCK_RPA=true
USE_MOCK_STORAGE=true
# 경쟁가 조회는 플랫폼별로 따로 켤 수 있다 (네이버=공식 API라 안전, 쿠팡=미검증 스크래핑이라 주의)
USE_MOCK_NAVER_PRICE_CHECKER=true
USE_MOCK_COUPANG_PRICE_CHECKER=true

# --- 오픈마켓 API 키 ---
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 네이버 쇼핑검색 오픈API 전용 키 (https://developers.naver.com/apps 에서 "검색" API로 발급 — Commerce API 키와 다름)
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_VENDOR_ID=
ESM_MASTER_ID=
ESM_API_KEY=

# --- AWS S3 / CloudFront ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=
AWS_CLOUDFRONT_DOMAIN=

# --- 솔라피(Solapi) ---
SOLAPI_API_KEY=
SOLAPI_API_SECRET=
SOLAPI_KAKAO_PFID=

# --- AI 연산 API (자체 GPU 미운영 시) ---
REPLICATE_API_TOKEN=
FAL_API_KEY=
